{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json,os,subprocess; d=json.load(sys.stdin); f=d.get('tool_input',{}).get('file_path',''); e=os.path.splitext(f)[1].lower(); sys.exit(subprocess.run(['node','--check',f]).returncode if e=='.js' else subprocess.run([sys.executable,'-m','py_compile',f]).returncode if e=='.py' else 0)\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\mpick\\.cce\\hooks\\cce_hook.cmd\" PostToolUse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\mpick\\.cce\\hooks\\cce_hook.cmd\" SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\mpick\\.cce\\hooks\\cce_hook.cmd\" UserPromptSubmit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\mpick\\.cce\\hooks\\cce_hook.cmd\" Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\mpick\\.cce\\hooks\\cce_hook.cmd\" SessionEnd"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-gstack.sh\""
          }
        ]
      }
    ]
  }
}
