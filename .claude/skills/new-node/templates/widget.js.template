/**
 * DirtyBirds Playhouse — {{TITLE}} UI.
 *
 * {{WHY_THIS_FILE_EXISTS}}
 *
 * Only add this file if the node needs frontend behaviour beyond suite theming
 * — a node with plain widgets does not need any JS. Sockets are declared by the
 * Python INPUT_TYPES / RETURN_TYPES, never here.
 */

import { app } from "../../../scripts/app.js";
import { DB_COLOR, DB_BGCOLOR, ensureStylesheet, addTitle } from "./db_shared.js";

ensureStylesheet();

app.registerExtension({
  name: "DirtyBirds.{{EXTENSION_NAME}}",
  async beforeRegisterNodeDef(nodeType, nodeData) {
    if (nodeData.name !== "{{CLASS_NAME}}") return;

    const onNodeCreated = nodeType.prototype.onNodeCreated;
    nodeType.prototype.onNodeCreated = function () {
      onNodeCreated?.apply(this, arguments);
      const node = this;
      node.color = DB_COLOR;
      node.bgcolor = DB_BGCOLOR;
      addTitle(node, "db_{{PACKAGE}}_title", "{{SECTION_LABEL}}");

      // Custom widgets / callbacks go here.
    };
  },
});
