# Local LLM model weights — far too large for git (download/place manually)
*.gguf

# Personal Claude Code config — machine-specific paths, not for the public repo
.claude/settings.local.json

# Saved prompts written by the sampler's Save Prompt button — local only
prompts.txt

# Python caches
__pycache__/
*.pyc

# Runtime caches
lora_meta_cache.json

# LoRA/embedding preview thumbnails — local only, not for the public repo
web/previews/

# User data directory (symlinks to external DirtyBirds-Playhouse_User)
user_files/

# Master wildcard configuration — local user data only
master.yaml

# CCE (code-context-engine)
# CCE local cache (per-machine, not for version control)
.cce/
# .mcp.json contains absolute paths regenerated by `cce init`
.mcp.json
.gstack/

# Pytest cache
.pytest_cache/
.pytest-bt/

# Loader settings — can hold a Civitai API token, never commit
dirtybirds_settings.json
